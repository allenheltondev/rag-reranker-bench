# Copy to .env and fill in. Nothing here is read until you run against the Oracle backend;
# `npm run bench -- --backend fixture` needs none of it.

# --- Oracle -------------------------------------------------------------------------------
ORACLE_USER=bench
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1

# Leave empty for thin mode (no Instant Client needed). Set a path to force thick mode.
ORACLE_CLIENT_LIB_DIR=

ORACLE_SCHEMA_PREFIX=BENCH

# Names of the ONNX models loaded with DBMS_VECTOR.LOAD_ONNX_MODEL (see sql/03_load_models.sql).
ORACLE_EMBED_MODEL=DOC_EMBEDDER
ORACLE_RERANK_MODEL=BGE_RERANKER

# Must match the embedding model you loaded, and the VECTOR column in sql/01_schema.sql.
ORACLE_EMBED_DIMS=384

# 'prediction' uses PREDICTION(...); 'utl_to_rerank' uses DBMS_VECTOR.UTL_TO_RERANK.
ORACLE_INDB_RERANK_API=prediction

# Override the scoring expression if your export loaded as a classifier rather than a
# regression, e.g.
#   ORACLE_INDB_SCORE_EXPR=PREDICTION_PROBABILITY(BGE_RERANKER, 1 USING :qtext AS FIRST_INPUT, TITLE || '. ' || CONTENT AS SECOND_INPUT)
# `npm run doctor` tells you which one your model answers to.
ORACLE_INDB_SCORE_EXPR=

# --- Application-side reranker ------------------------------------------------------------
# Must be the same checkpoint the database runs, or the benchmark compares two models instead
# of two locations. scripts/export-reranker-onnx.sh puts it here.
APP_RERANK_MODEL_PATH=./models/bge-reranker-base
APP_RERANK_DTYPE=fp32
APP_RERANK_DEVICE=cpu
APP_RERANK_MAX_LENGTH=512
APP_RERANK_BATCH_SIZE=16

# ONNX Runtime intra-op threads. Leave unset for the default. Whatever you choose is recorded
# in the report, because it moves the numbers more than anything else on this list.
APP_RERANK_THREADS=

# --- Benchmark ----------------------------------------------------------------------------
BENCH_BACKEND=oracle
BENCH_ITERATIONS=20
BENCH_WARMUP=5
BENCH_TOP_K=10
BENCH_CANDIDATES=10,20,40,80
BENCH_RERANKERS=none,in-db,app
BENCH_RETRIEVALS=vector,lexical,hybrid-rrf
BENCH_RRF_K=60
BENCH_QUERIES=0

# --- Corpus -------------------------------------------------------------------------------
CORPUS_SIZE=480
CORPUS_SEED=20250917
