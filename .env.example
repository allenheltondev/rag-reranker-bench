# Copy to .env and fill in. Nothing here is read until you run against the Oracle backend;
# `npm run bench -- --backend fixture` needs none of it.

# --- Oracle -------------------------------------------------------------------------------
# Elevated credentials, used only by `npm run bootstrap` to create the benchmark user.
# Container: SYS, and docker compose reads ORACLE_SYS_PASSWORD from this file as the SYS
# password when it first creates the database. Autonomous: set ORACLE_SYS_USER=ADMIN.
ORACLE_SYS_USER=sys
ORACLE_SYS_PASSWORD=ChangeMe_1

# The benchmark user. `npm run bootstrap` creates it with exactly this password.
ORACLE_USER=BENCH
ORACLE_PASSWORD=ChangeMe_1

# Quota tablespace. Blank picks USERS for the container, DATA for Autonomous.
ORACLE_TABLESPACE=
ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1

# One session by default. The harness issues a single statement at a time, and every session
# that scores holds its own copy of the model in PGA, so a larger pool multiplies the
# database's memory requirement for no benefit.
ORACLE_POOL_MAX=1

# Leave empty for thin mode (no Instant Client needed). Set a path to force thick mode.
ORACLE_CLIENT_LIB_DIR=

ORACLE_SCHEMA_PREFIX=BENCH

# 'local': ONNX files come from a directory object in the container.
# 'adb':   ONNX files come from Object Storage via the PAR URL that infra/oci outputs.
ORACLE_TARGET=local
ORACLE_ONNX_DIRECTORY=ONNX_DIR
# Path the directory object points at, inside the database container.
ORACLE_ONNX_PATH=/opt/oracle/onnx
ORACLE_MODELS_PAR_URL=
# Oracle's published augmented export of all-MiniLM-L12-v2: 384 dims, no prefixes needed.
# `npm run fetch:model -- <url>` saves it under exactly this name. See the README for the URL.
ORACLE_EMBED_FILE=all_MiniLM_L12_v2.onnx

# Instruction prefixes the embedding model expects. Leave both blank for MiniLM / GTE.
#   E5 family:  query: / passage:   (both required, including the trailing space)
#   BGE family: query prefix only, e.g. "Represent this sentence for searching relevant passages: "
# Getting these wrong does not error, it quietly costs recall. Must be set BEFORE `npm run load`,
# because documents are embedded at insert time.
ORACLE_EMBED_QUERY_PREFIX=
ORACLE_EMBED_DOC_PREFIX=
ORACLE_RERANK_FILE=bge_reranker_base.onnx

# How the cross-encoder's graph inputs map to SQL arguments. The default matches the
# single-input graph `npm run augment:rerank-model` produces, where the query and passage are
# packed into one string by ORACLE_INDB_SCORE_EXPR. A model from Oracle's own two-input
# converter instead wants: { "input": ["FIRST_INPUT", "SECOND_INPUT"] }
ORACLE_RERANK_INPUT_SPEC={ "input": ["DATA"] }

# Names of the ONNX models loaded with DBMS_VECTOR.LOAD_ONNX_MODEL (see sql/03_load_models.sql).
ORACLE_EMBED_MODEL=DOC_EMBEDDER
ORACLE_RERANK_MODEL=BGE_RERANKER

# Must match the embedding model you loaded, and the VECTOR column in sql/01_schema.sql.
ORACLE_EMBED_DIMS=384

# separate-session (default): embed on a dedicated DB session, bind the exact vector
# into retrieval on the other session. Both calls are included in request latency.
# inline: original one-statement path; reproduces the model-switch penalty.
ORACLE_QUERY_EMBEDDING=separate-session

# 'prediction' uses PREDICTION(...); 'utl_to_rerank' uses DBMS_VECTOR.UTL_TO_RERANK.
ORACLE_INDB_RERANK_API=prediction

# How the cross-encoder is scored. `npm run augment:rerank-model` prints the exact expression
# for the model it builds; paste it here. Set it ONCE - a second assignment of this key
# anywhere below silently replaces the first.
#
# For a model loaded as a classifier rather than a regression, the shape is
# PREDICTION_PROBABILITY(BGE_RERANKER, 1 USING ...). `npm run doctor` scores a matching pair
# against an irrelevant one, which is what tells you whether you picked right.
ORACLE_INDB_SCORE_EXPR=

# The control's stand-in for the model: same text, same bind, no inference. Change it only if
# you changed ORACLE_INDB_SCORE_EXPR to read different columns.
#   default: LENGTH(:qtext || TITLE || '. ' || CONTENT)
ORACLE_INDB_CONTROL_EXPR=

# --- Application-side reranker ------------------------------------------------------------
# Must be the same checkpoint the database runs, or the benchmark compares two models instead
# of two locations. scripts/export-reranker-onnx.sh puts it here.
APP_RERANK_MODEL_PATH=./models/bge-reranker-base
# fp32 by default. Set q8 ONLY after `npm run augment:rerank-model -- --quantize`, which
# quantizes the shared model body so both arms run the same weights. Changing this alone would
# leave the two arms running different models.
APP_RERANK_DTYPE=fp32
APP_RERANK_DEVICE=cpu
APP_RERANK_MAX_LENGTH=512
APP_RERANK_BATCH_SIZE=16

# ONNX Runtime intra-op threads. Leave unset for the default. Whatever you choose is recorded
# in the report, because it moves the numbers more than anything else on this list.
APP_RERANK_THREADS=

# --- Benchmark ----------------------------------------------------------------------------
BENCH_BACKEND=oracle
BENCH_ITERATIONS=20
BENCH_WARMUP=5
BENCH_TOP_K=10
BENCH_CANDIDATES=10,20,40,80
BENCH_RERANKERS=none,in-db,app
BENCH_RETRIEVALS=vector,lexical,hybrid-rrf
BENCH_RRF_K=60
BENCH_QUERIES=0

# Full repetitions of the protocol. The report shows the between-repeat spread of every
# scoring cost, which is the repeatability figure. Three is a reasonable minimum to publish.
BENCH_REPEATS=1

# Between isolation batches (in-database arm, application arm, transfer batch) the harness
# closes the pool, disposes the model, and idles for this long before warming up again.
BENCH_QUIESCE_MS=5000

# Optional command run at each reset for a true teardown, e.g.
#   BENCH_RESET_CMD="docker compose restart oracle && sleep 90"
BENCH_RESET_CMD=

# --- Corpus -------------------------------------------------------------------------------
CORPUS_SIZE=480
CORPUS_SEED=20250917
